# Copy this file to .env and fill in real values. NEVER commit .env to Git.
NODE_ENV=development
PORT=3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=edutrack

# JWT (generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1h

# Security
CORS_ORIGIN=*
RATE_LIMIT_MAX=100
